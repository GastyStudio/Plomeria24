---
// Header.astro — barra de navegación fija, se compacta al hacer scroll.
const WHATSAPP_NUMBER = '5491167845506'; //
const navLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#por-que-elegirnos', label: 'Por qué elegirnos' },
  { href: '#proceso', label: 'Cómo trabajamos' },
  { href: '#cobertura', label: 'Cobertura' },
  { href: '#faq', label: 'Preguntas' },
];
---

<header class="header" id="site-header">
  <div class="container header__bar">
    <a href="#top" class="header__brand" aria-label="Plomeria24, ir al inicio">
      <img src="/images/logo-plomeria24.jpg" alt="Plomeria24" width="44" height="44" />
      <span class="header__brand-text">
        <strong>Plomeria24</strong>
        <small>Plomería · Piscinas y casa</small>
      </span>
    </a>

    <nav class="header__nav" aria-label="Navegación principal">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a
        class="btn btn--primary header__cta"
        href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola Fernando, quiero pedir un presupuesto.')}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2m0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24 2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.83c0 4.55-3.71 8.25-8.26 8.25m4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.4-.12-.56.13-.17.24-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.24-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.36-.77-1.86 -.2 -.48 -.41 -.42 -.56 -.43h -.48c -.17 0 -.43 .06 -.66 .31 -.22 .25 -.87 .85 -.87 2 .0 .0 .0 .0 .0 .0z"/></svg>
        WhatsApp
      </a>
      <button class="header__burger" id="burgerBtn" aria-expanded="false" aria-controls="mobileNav" aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobileNav" data-open="false">
    <ul>
      {navLinks.map((link) => (
        <li><a href={link.href} class="mobile-nav__link">{link.label}</a></li>
      ))}
    </ul>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(245, 250, 254, 0.82);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid rgba(220, 231, 238, 0.7);
    transition: box-shadow 0.4s var(--ease), background 0.4s var(--ease);
  }
  .header.is-scrolled {
    box-shadow: var(--shadow-sm);
  }

  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.85rem;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }
  .header__brand img {
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--blue-100);
  }
  .header__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .header__brand-text strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--navy-950);
  }
  .header__brand-text small {
    font-size: 0.72rem;
    color: var(--blue-600);
    font-weight: 600;
    letter-spacing: 0.03em;
  }

  .header__nav ul {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
  }
  .header__nav a {
    font-size: 0.94rem;
    font-weight: 600;
    color: var(--ink-700);
    position: relative;
    padding-block: 0.3rem;
    transition: color 0.25s var(--ease);
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0; bottom: 0;
    width: 0%;
    height: 2px;
    background: var(--copper-500);
    transition: width 0.3s var(--ease);
  }
  .header__nav a:hover {
    color: var(--navy-950);
  }
  .header__nav a:hover::after { width: 100%; }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .header__cta {
    padding: 0.65rem 1.3rem;
    font-size: 0.9rem;
  }

  .header__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .header__burger span {
    display: block;
    width: 18px;
    height: 2px;
    margin-inline: auto;
    background: var(--navy-950);
    transition: transform 0.3s var(--ease), opacity 0.3s var(--ease);
  }
  .header__burger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .header__burger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .header__burger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-nav {
    max-height: 0;
    overflow: hidden;
    background: var(--white);
    border-bottom: 1px solid var(--line);
    transition: max-height 0.4s var(--ease);
  }
  .mobile-nav[data-open="true"] { max-height: 400px; }
  .mobile-nav ul {
    display: flex;
    flex-direction: column;
    padding: 0.5rem clamp(1.25rem, 4vw, 2.5rem) 1.25rem;
  }
  .mobile-nav__link {
    display: block;
    padding: 0.8rem 0;
    font-weight: 600;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 880px) {
    .header__nav { display: none; }
    .header__burger { display: flex; }
    .header__cta { display: none; }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const burger = document.getElementById('burgerBtn');
  const mobileNav = document.getElementById('mobileNav');

  const onScroll = () => {
    if (!header) return;
    header.classList.toggle('is-scrolled', window.scrollY > 12);
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  burger?.addEventListener('click', () => {
    const isOpen = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!isOpen));
    mobileNav?.setAttribute('data-open', String(!isOpen));
  });

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      burger?.setAttribute('aria-expanded', 'false');
      mobileNav.setAttribute('data-open', 'false');
    });
  });
</script>
