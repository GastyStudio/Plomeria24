---
// Hero.astro — sección de apertura. Fondo tipo "plano técnico" (blueprint)
// e ilustración de cañerías propia, ya que el oficio es justamente eso: leer
// y resolver el recorrido del agua dentro de una casa.
const WHATSAPP_NUMBER = '5491167845506';
---

<section class="hero" id="top">
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy reveal">
      <p class="eyebrow eyebrow--light">Plomería domiciliaria y comercial · CABA y GBA</p>
      <h1 class="hero__title">
        Se soluciona hoy,<br />
        no <span>"cuando pueda pasar"</span>.
      </h1>
      <p class="hero__lead">
        Destapaciones, pérdidas, instalaciones de agua y gas, calefones y más.
        Un plomero de confianza que llega, diagnostica y resuelve — con
        presupuesto sin cargo antes de empezar.
      </p>

      <div class="hero__ctas">
        <a
          class="btn btn--primary"
          href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola Fernando, quiero pedir un presupuesto.')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2m0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24 2.2 0 4.27.86
  5.83 2.42a8.2 8.2 0 0 1 2.42 5.83c0 4.55-3.71 8.25-8.26 8.25m4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.4-.12-.56.13-.17.24-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.24-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.36-.77-1.86-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31c0 .25c0 .87c0 .85c0 2.08 0 1.22 0 2.4 0 1.02 0 2.57 0 3.74c0 .26 0 .41 0 .52c0 .19 0 .16 0 .1c0 .07 0 .6 0 .6c0 .58 0 .21 0 .14c-.06-.1-.23-.16-.48-.28"/></svg>
          Solicitar presupuesto por WhatsApp
        </a>
        <a class="btn btn--ghost" href="#servicios">Ver servicios</a>
      </div>

      <ul class="hero__badges">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg> Presupuesto por WhatsApp</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg> Trabajos garantizados</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg> CABA y GBA</li>
      </ul>
    </div>

    <div class="hero__art reveal" style="--stagger-index: 1">
      <svg viewBox="0 0 420 460" class="hero__svg" role="img" aria-label="Esquema ilustrado de cañerías dentro de una casa">
        <defs>
          <linearGradient id="pipeGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#d69259"/>
            <stop offset="1" stop-color="#a8632e"/>
          </linearGradient>
        </defs>
        <!-- silueta casa -->
        <path d="M60 200 L210 90 L360 200 V400 A16 16 0 0 1 344 416 H76 A16 16 0 0 1 60 400 Z" fill="#0e3a5c" opacity="0.08"/>
        <path d="M60 200 L210 90 L360 200" fill="none" stroke="#0e3a5c" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" opacity="0.35"/>
        <rect x="76" y="200" width="268" height="216" rx="14" fill="none" stroke="#0e3a5c" stroke-width="6" opacity="0.35"/>

        <!-- recorrido de cañería (elemento propio del oficio) -->
        <path d="M100 416 V300 H160 V250 H240 V300 H300 V230 H320 V150" fill="none" stroke="url(#pipeGrad)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
        <!-- juntas / válvulas -->
        <circle cx="160" cy="300" r="9" fill="#0b2740"/>
        <circle cx="240" cy="250" r="9" fill="#0b2740"/>
        <circle cx="300" cy="300" r="9" fill="#0b2740"/>
        <circle cx="320" cy="230" r="9" fill="#0b2740"/>
        <g transform="translate(320,150)">
          <circle r="16" fill="#f5fafe" stroke="#a8632e" stroke-width="5"/>
          <path d="M-6 0 A6 6 0 1 1 6 0" stroke="#a8632e" stroke-width="4" fill="none"/>
        </g>

        <!-- gotas -->
        <path d="M182 190 c0 10 -9 14 -9 22 a9 9 0 0 0 18 0 c0-8-9-12-9-22Z" fill="#2c98d1" opacity="0.85"/>
        <path d="M238 172 c0 8 -7 11 -7 18 a7 7 0 0 0 14 0c0-7-7-10-7-18Z" fill="#2c98d1" opacity="0.6"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: radial-gradient(ellipse at 15% 0%, var(--navy-800) 0%, var(--navy-950) 62%);
    color: var(--white);
    overflow: hidden;
    padding-block: clamp(5.5rem, 11vw, 8rem) clamp(4rem, 8vw, 6rem);
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .eyebrow--light { color: var(--copper-400); }
  .eyebrow--light::before { background: var(--copper-400); }

  .hero__title {
    font-size: var(--fs-hero);
    color: var(--white);
    max-width: 14ch;
  }
  .hero__title span { color: var(--copper-400); }

  .hero__lead {
    margin-top: 1.4rem;
    font-size: var(--fs-lead);
    color: #cfe0ee;
    max-width: 46ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2.2rem;
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 2.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(255,255,255,0.14);
  }
  .hero__badges li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: #d8e6f1;
  }
  .hero__badges svg {
    width: 18px; height: 18px;
    color: var(--copper-400);
    flex-shrink: 0;
  }

  .hero__art { display: flex; justify-content: center; }
  .hero__svg { width: 100%; max-width: 380px; height: auto; }

  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; text-align: left; }
    .hero__art { order: -1; max-width: 260px; margin-inline: auto; }
  }
</style>
