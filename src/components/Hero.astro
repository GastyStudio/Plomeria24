---
// Hero.astro — sección de apertura con imagen de fondo real (foto del cliente).
const WHATSAPP_NUMBER = '5491167845506';
const WHATSAPP_DISPLAY = '+54 9 11 6784-5506';
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__copy reveal">
      <p class="eyebrow eyebrow--light">Plomería domiciliaria y comercial · CABA y GBA</p>
      <h1 class="hero__title">
        Se soluciona hoy,<br />
        no <span>"cuando pueda pasar"</span>.
      </h1>
      <p class="hero__lead">
        Destapaciones, pérdidas, instalaciones de agua y gas, calefones y más.
        Un plomero de confianza que llega, diagnostica y resuelve — con
        presupuesto sin cargo antes de empezar.
      </p>

      
        <a class="hero__whatsapp"
        href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola Fernando, tengo una urgencia y necesito un plomero ya.')}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="hero__whatsapp-pulse" aria-hidden="true"></span>
        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01a9.816 9.816 0 0 0-7.01-2.91m0 18.15c-1.5 0-2.97-.4-4.25-1.15l-.31-.18-3.12.82.83-3.04-.2-.32a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c.02 4.54-3.68 8.24-8.23 8.24m4.52-6.16c-.25-.12-1.47-.73-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.78.97-.14.17-.29.19-.54.07-.25-.12-1.06-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.13-.14.17-.24.25-.4.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31s-.86.85-.86 2.07.89 2.4 1.01 2.56c.12.17 1.74 2.65 4.21 3.72.59.25 1.05.4 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29"/>
        </svg>
        <span class="hero__whatsapp-text">
          <strong>¿Urgencia? Escribinos ahora</strong>
          <small>{WHATSAPP_DISPLAY}</small>
        </span>
      </a>

      <a class="hero__link-secondary" href="#servicios">Ver todos los servicios →</a>

      <ul class="hero__badges">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg> Respuesta inmediata</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg> Trabajos garantizados</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg> CABA y GBA</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background-image:
      linear-gradient(rgba(8, 27, 46, 0.6), rgba(8, 27, 46, 0.6)),
      url('/images/plomero.webp');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding-block: clamp(6rem, 14vw, 10rem);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
  }

  .hero__copy {
    max-width: 720px;
    text-align: center;
  }

  .eyebrow--light { color: var(--copper-400); }
  .eyebrow--light::before { background: var(--copper-400); }

  .hero__title {
    font-size: var(--fs-hero);
    color: var(--white);
  }
  .hero__title span { color: var(--copper-400); }

  .hero__lead {
    margin-top: 1.4rem;
    font-size: var(--fs-lead);
    color: #cfe0ee;
    max-width: 46ch;
    margin-inline: auto;
  }

  /* ---------- Botón de WhatsApp / CTA de urgencia ---------- */
  .hero__whatsapp {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 2.4rem;
    padding: 1.1rem 2.2rem;
    background: linear-gradient(135deg, var(--copper-500), var(--copper-600));
    color: var(--white);
    border-radius: 100px;
    box-shadow: var(--shadow-lg);
    isolation: isolate;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .hero__whatsapp:hover {
    transform: translateY(-3px) scale(1.02);
  }

  .hero__whatsapp-pulse {
    position: absolute;
    inset: 0;
    border-radius: 100px;
    background: var(--copper-500);
    z-index: -1;
    animation: pulse-urgente 2s ease-out infinite;
  }
  @keyframes pulse-urgente {
    0% { box-shadow: 0 0 0 0 rgba(193, 121, 61, 0.55); }
    70% { box-shadow: 0 0 0 18px rgba(193, 121, 61, 0); }
    100% { box-shadow: 0 0 0 0 rgba(193, 121, 61, 0); }
  }

  .hero__whatsapp-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.25;
    text-align: left;
  }
  .hero__whatsapp-text strong {
    font-size: 1.15rem;
    font-family: var(--font-display);
    font-weight: 800;
  }
  .hero__whatsapp-text small {
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.02em;
  }

  .hero__link-secondary {
    display: block;
    margin-top: 1.1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #cfe0ee;
    text-decoration: underline;
    text-underline-offset: 3px;
    opacity: 0.85;
    transition: opacity 0.25s var(--ease);
  }
  .hero__link-secondary:hover { opacity: 1; }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.4rem;
    margin-top: 2.4rem;
    padding-top: 1.6rem;
    border-top: 1px solid rgba(255,255,255,0.14);
  }
  .hero__badges li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: #d8e6f1;
  }
  .hero__badges svg {
    width: 18px; height: 18px;
    color: var(--copper-400);
    flex-shrink: 0;
  }

  @media (max-width: 480px) {
    .hero__whatsapp {
      flex-direction: column;
      text-align: center;
      padding: 1.2rem 1.6rem;
    }
    .hero__whatsapp-text { align-items: center; text-align: center; }
  }
</style>