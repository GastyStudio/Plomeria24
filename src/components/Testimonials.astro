---
// Testimonials.astro — reseñas de clientes en formato tarjeta.
const testimonials = [
  { name: 'Marina G.', zone: 'Caballito, CABA', text: 'Vino el mismo día por una pérdida en el baño. Prolijo y explicó todo antes de cobrar.', rating: 5 },
  { name: 'Diego R.', zone: 'Lomas de Zamora, GBA', text: 'Cambió toda la instalación de agua de la cocina. Quedó impecable y respetó el presupuesto.', rating: 5 },
  { name: 'Laura P.', zone: 'Banfield, GBA', text: 'Reparó el calefón un domingo a la tarde. Rapidez y buena onda para explicar el problema.', rating: 5 },
  { name: 'Nicolás F.', zone: 'Palermo, CABA', text: 'Hace mantenimiento mensual en mi local. Nunca tuve que llamar dos veces por lo mismo.', rating: 5 },
];
---

<section class="testimonials">
  <div class="container">
    <div class="section-head center reveal">
      <p class="eyebrow">Clientes</p>
      <h2>Lo que dicen después del trabajo terminado</h2>
    </div>

    <div class="testimonials__grid reveal-stagger reveal">
      {testimonials.map((t, i) => (
        <figure class="card testimonials__card" style={`--stagger-index: ${i}`}>
          <div class="testimonials__stars" aria-label={`${t.rating} de 5 estrellas`}>
            {Array.from({ length: t.rating }).map(() => (
              <svg viewBox="0 0 20 20" fill="currentColor"><path d="M10 1.5l2.6 5.5 6 .8-4.4 4.2 1.1 6-5.3-2.9-5.3 2.9 1.1-6L1.4 7.8l6-.8Z"/></svg>
            ))}
          </div>
          <blockquote>{t.text}</blockquote>
          <figcaption>
            <strong>{t.name}</strong>
            <span>{t.zone}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials { background: var(--sky-50); }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.4rem;
  }
  .testimonials__card {
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .testimonials__stars {
    display: flex;
    gap: 0.2rem;
    color: var(--copper-500);
  }
  .testimonials__stars svg { width: 16px; height: 16px; }
  .testimonials__card blockquote {
    margin: 0;
    font-size: 0.95rem;
    color: var(--ink-700);
    line-height: 1.6;
  }
  .testimonials__card figcaption {
    display: flex;
    flex-direction: column;
    font-size: 0.85rem;
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
  }
  .testimonials__card figcaption strong { color: var(--navy-950); }
  .testimonials__card figcaption span { color: var(--ink-500); }
</style>
