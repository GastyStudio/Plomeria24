---
// Process.astro — 4 pasos reales del servicio, conectados por una línea de
// "cañería" con válvulas: la única sección donde una numeración 1-4 tiene
// sentido, porque describe una secuencia real de trabajo.
const steps = [
  { n: '01', title: 'Contacto', text: 'Nos escribís por WhatsApp y contás qué necesitás resolver.' },
  { n: '02', title: 'Presupuesto', text: 'Coordinamos visita o diagnóstico a distancia y cotizamos sin cargo.' },
  { n: '03', title: 'Reparación', text: 'Ejecutamos el trabajo con materiales de calidad y prolijidad.' },
  { n: '04', title: 'Garantía', text: 'Respaldamos el trabajo realizado y quedamos disponibles ante cualquier duda.' },
];
---

<section class="process" id="proceso">
  <div class="container">
    <div class="section-head center reveal">
      <p class="eyebrow">Cómo trabajamos</p>
      <h2>Un recorrido simple, de punta a punta</h2>
      <p>Igual que seguimos el recorrido de una cañería hasta encontrar la solución, el proceso con vos es igual de directo.</p>
    </div>

    <div class="process__row reveal-stagger reveal">
      <svg class="process__line" viewBox="0 0 1000 40" preserveAspectRatio="none" aria-hidden="true">
        <line x1="60" y1="20" x2="940" y2="20" stroke="#c9d9e4" stroke-width="3" stroke-dasharray="1 10" stroke-linecap="round"/>
      </svg>

      {steps.map((s, i) => (
        <div class="process__step" style={`--stagger-index: ${i}`}>
          <div class="process__node">
            <span>{s.n}</span>
          </div>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process { background: var(--white); }

  .process__row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }
  .process__line {
    display: none;
  }
  @media (min-width: 881px) {
    .process__line {
      display: block;
      position: absolute;
      top: 26px;
      left: 0;
      width: 100%;
      height: 40px;
      z-index: 0;
    }
  }

  .process__step {
    position: relative;
    z-index: 1;
    text-align: center;
  }
  .process__node {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--white);
    border: 3px solid var(--copper-500);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.2rem;
    box-shadow: var(--shadow-sm);
  }
  .process__node span {
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--navy-950);
    font-size: 0.95rem;
  }
  .process__step h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }
  .process__step p {
    font-size: 0.88rem;
    color: var(--ink-500);
    max-width: 26ch;
    margin-inline: auto;
  }

  @media (max-width: 880px) {
    .process__row {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
    .process__step { text-align: left; display: flex; gap: 1.1rem; align-items: flex-start; }
    .process__node { margin: 0; flex-shrink: 0; }
  }
</style>
