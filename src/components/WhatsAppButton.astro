---
// WhatsAppButton.astro — botón flotante, fijo, aparece con una animación
// suave luego de un pequeño scroll para no tapar el hero de entrada.
const WHATSAPP_NUMBER = '5491100000000'; // TODO: reemplazar por el número real
---

<a
  id="waFloat"
  class="wa-float"
  href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent('Hola Fernando, quiero pedir un presupuesto sin cargo.')}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar por WhatsApp"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2m0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24 2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.83c0 4.55-3.71 8.25-8.26 8.25m4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.4-.12-.56.13-.17.24-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.24-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.36-.77-1.86-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.08 0 1.22.89 2.4 1.02 2.57.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.16-.48-.28"/></svg>
  <span class="visually-hidden">Contactar por WhatsApp</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: clamp(1rem, 4vw, 2rem);
    bottom: clamp(1rem, 4vw, 2rem);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(37, 211, 102, 0.92);
    color: var(--white);
    box-shadow: 0 10px 28px rgba(11, 39, 64, 0.28);
    z-index: 90;
    opacity: 0;
    transform: translateY(18px) scale(0.9);
    pointer-events: none;
    transition: opacity 0.5s var(--ease), transform 0.5s var(--ease), background 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .wa-float.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .wa-float:hover {
    background: rgba(30, 190, 90, 1);
    box-shadow: 0 14px 34px rgba(11, 39, 64, 0.36);
    transform: translateY(-4px) scale(1.05);
  }
  .wa-float svg { width: 30px; height: 30px; }

  @media (max-width: 540px) {
    .wa-float { width: 54px; height: 54px; }
    .wa-float svg { width: 27px; height: 27px; }
  }
</style>

<script>
  const waBtn = document.getElementById('waFloat');
  const reveal = () => {
    if (!waBtn) return;
    waBtn.classList.toggle('is-visible', window.scrollY > 420);
  };
  document.addEventListener('scroll', reveal, { passive: true });
  reveal();
</script>
