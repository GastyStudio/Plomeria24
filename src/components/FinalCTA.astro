---
// FinalCTA.astro — cierre de página, última invitación a contactar.
const WHATSAPP_NUMBER = '5491167845506';
---

<section class="final-cta">
  <div class="final-cta__grid" aria-hidden="true"></div>
  <div class="container final-cta__inner reveal">
    <h2>¿Tenés un problema de plomería ahora mismo?</h2>
    <p>Contanos qué pasa y te respondemos con un presupuesto sin cargo. Sin vueltas, sin letra chica.</p>
    <a
      class="btn btn--primary final-cta__btn"
      href={`https://wa.me/${5491167845506}?text=${encodeURIComponent('Hola Fernando, quiero pedir un presupuesto sin cargo.')}`}
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.46 1.32 4.96L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.45 9.9-9.91C21.96 6.45 17.5 2 12.04 2m0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.26-8.24 2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.42 5.83c0 4.55-3.71 8.25-8.26 8.25m4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.4-.12-.56.13-.17.24-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.24-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.36-.77-1.86-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.87.85-.87 2.08 0 1.22.89 2.4 1.02 2.57.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.16-.48-.28"/></svg>
      Solicitar presupuesto por WhatsApp
    </a>
  </div>
</section>

<style>
  .final-cta {
    position: relative;
    background: linear-gradient(135deg, var(--navy-900), var(--navy-950));
    color: var(--white);
    overflow: hidden;
    padding-block: clamp(4rem, 8vw, 6rem);
  }
  .final-cta__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 80% 20%, rgba(193,121,61,0.18), transparent 45%);
  }
  .final-cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 640px;
  }
  .final-cta h2 {
    color: var(--white);
    font-size: var(--fs-h2);
  }
  .final-cta p {
    margin-top: 1rem;
    color: #cfe0ee;
    font-size: var(--fs-lead);
  }
  .final-cta__btn { margin-top: 2rem; }
</style>
