---
// Footer.astro — pie de página con datos de contacto y navegación.
const WHATSAPP_NUMBER = '5491100000000';
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="#top" class="footer__logo">
        <img src="/images/logo-plomeria24.jpg" alt="Plomeria24" width="48" height="48" />
        <span>
          <strong>Plomeria24</strong>
          <small>Plomería · Piscinas y casa</small>
        </span>
      </a>
      <p>Plomería domiciliaria y comercial en Capital Federal y Gran Buenos Aires.</p>
      <div class="footer__social">
        <a href="#" aria-label="Instagram de Fernando Plomería" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>
        </a>
        <a href="#" aria-label="Facebook de Fernando Plomería" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 9h3V6h-3a3 3 0 0 0-3 3v2H8v3h3v6h3v-6h3l1-3h-4v-2a1 1 0 0 1 1-1Z"/></svg>
        </a>
      </div>
    </div>

    <nav class="footer__col" aria-label="Navegación del pie de página">
      <h3>Navegación</h3>
      <ul>
        <li><a href="#servicios">Servicios</a></li>
        <li><a href="#por-que-elegirnos">Por qué elegirnos</a></li>
        <li><a href="#proceso">Cómo trabajamos</a></li>
        <li><a href="#cobertura">Cobertura</a></li>
        <li><a href="#faq">Preguntas frecuentes</a></li>
      </ul>
    </nav>

    <div class="footer__col">
      <h3>Contacto</h3>
      <ul>
        <li>
          <a href={`https://wa.me/${5491167845506}`} target="_blank" rel="noopener noreferrer">WhatsApp: +54 9 11 0000-0000</a>
        </li>
        <li><a href="mailto:contacto@fernandoplomeria.com.ar">contacto@fernandoplomeria.com.ar</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h3>Horarios</h3>
      <ul>
        <li>Lunes a viernes: 8 a 19 hs</li>
        <li>Sábados: 9 a 14 hs</li>
        <li>Urgencias: 24/7</li>
      </ul>
      <h3 class="footer__spacer">Cobertura</h3>
      <ul>
        <li>CABA y Gran Buenos Aires</li>
      </ul>
    </div>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {currentYear} Fernando Plomería. Todos los derechos reservados.</p>
    <p>Sitio desarrollado por GastyCoriaOK.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--navy-950);
    color: #a9c2d6;
    padding-top: clamp(3rem, 6vw, 4.5rem);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .footer__logo {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1rem;
  }
  .footer__logo img { border-radius: 50%; }
  .footer__logo span { display: flex; flex-direction: column; line-height: 1.2; }
  .footer__logo strong { color: var(--white); font-family: var(--font-display); font-size: 1.15rem; }
  .footer__logo small { color: var(--copper-400); font-size: 0.75rem; font-weight: 600; }

  .footer__brand p { font-size: 0.88rem; max-width: 30ch; }

  .footer__social { display: flex; gap: 0.7rem; margin-top: 1.2rem; }
  .footer__social a {
    width: 38px; height: 38px;
    display: flex; align-items: center; justify-content: center;
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 50%;
    transition: background 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .footer__social a:hover { background: var(--copper-500); border-color: var(--copper-500); }
  .footer__social svg { width: 18px; height: 18px; }

  .footer__col h3 {
    color: var(--white);
    font-size: 0.92rem;
    margin-bottom: 1rem;
  }
  .footer__col .footer__spacer { margin-top: 1.5rem; }
  .footer__col ul { display: flex; flex-direction: column; gap: 0.6rem; }
  .footer__col li { font-size: 0.86rem; }
  .footer__col a:hover { color: var(--white); }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1.5rem;
    font-size: 0.78rem;
    color: #6f8ba1;
  }

  @media (max-width: 880px) {
    .footer__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 540px) {
    .footer__grid { grid-template-columns: 1fr; }
    .footer__bottom { flex-direction: column; text-align: center; }
  }
</style>
