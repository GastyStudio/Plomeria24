---
// Layout.astro — plantilla base: head, SEO, meta tags, esqueleto de la página.
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Fernando Plomería | Plomero en CABA y GBA — Presupuesto sin cargo',
  description = 'Servicio de plomería domiciliaria y comercial en Capital Federal y Gran Buenos Aires. Destapaciones, reparación de pérdidas, gas, calefones y más. Presupuesto sin cargo por WhatsApp.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/images/logo.jpg" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Fernando Plomería" />
    <meta name="theme-color" content="#0b2740" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fernando Plomería" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/logo.jpg" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_AR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/logo.jpg" />

    <!-- Preconnect fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Datos estructurados: negocio local -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Plumber',
      name: 'Fernando Plomería',
      image: `${Astro.site}images/logo.jpg`,
      description,
      areaServed: [
        { '@type': 'City', name: 'Ciudad Autónoma de Buenos Aires' },
        { '@type': 'AdministrativeArea', name: 'Gran Buenos Aires' },
      ],
      priceRange: '$$',
      url: Astro.site,
    })} />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido principal</a>
    <slot />
  </body>
</html>
